{
    "name": "@fluxmodels/core",
    "version": "1.0.0",
    "license": "MIT",
    "description": "FluxModels is a type-safe state management library",
    "author": {
        "name": "Vadzim Sharai",
        "email": "vadzimsharai@gmail.com"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fluxmodels/fluxmodels.git"
    },
    "bugs": {
        "url": "https://github.com/fluxmodels/fluxmodels/issues"
    },
    "homepage": "https://fluxmodels.dev",
    "tags": [
        "model",
        "reactive",
        "meta",
        "state",
        "state management",
        "flux",
        "fluxmodels",
        "typescript"
    ],
    "keywords": [
        "model",
        "reactive",
        "meta",
        "state",
        "state management",
        "flux",
        "fluxmodels",
        "typescript"
    ],
    "main": "./lib/index.js",
    "module": "./lib/index.mjs",
    "types": "./index.d.ts",
    "browser": "./lib/index.js",
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "require": "./lib/index.js",
            "import": "./lib/index.mjs"
        }
    },
    "files": [
        "/lib",
        "/index.d.ts"
    ],
    "scripts": {
        "sandbox": "jest ./tests/sandbox.test.ts",
        "build": "rollup -c",
        "build:dev": "rollup -cw"
    },
    "dependencies": {
        "metatyper": "=1.7.0"
    },
    "devDependencies": {
        "@rollup/plugin-node-resolve": "^15.2.3",
        "@rollup/plugin-terser": "^0.4.4",
        "@rollup/plugin-typescript": "^12.3.0",
        "@types/jest": "^29.5.12",
        "@types/node": "^20.14.10",
        "globals": "^16.5.0",
        "jest": "^29.7.0",
        "rimraf": "^6.1.2",
        "rollup": "^4.53.3",
        "rollup-plugin-filesize": "^10.0.0",
        "ts-jest": "^29.4.6",
        "typescript": "^5.5.3"
    },
    "packageManager": "yarn@4.11.0",
    "sideEffects": false
}
