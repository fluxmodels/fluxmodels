{
    "name": "@fluxmodels/react",
    "version": "1.0.1",
    "license": "MIT",
    "description": "FluxModels is a type-safe state management library for React applications",
    "author": {
        "name": "Vadzim Sharai",
        "email": "vadzimsharai@gmail.com"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fluxmodels/fluxmodels.git"
    },
    "bugs": {
        "url": "https://github.com/fluxmodels/fluxmodels/issues"
    },
    "homepage": "https://fluxmodels.dev",
    "tags": [
        "react",
        "model",
        "reactive",
        "meta",
        "state",
        "useState",
        "state management",
        "flux",
        "fluxmodels",
        "typescript"
    ],
    "keywords": [
        "react",
        "model",
        "reactive",
        "meta",
        "state",
        "useState",
        "state management",
        "flux",
        "fluxmodels",
        "typescript"
    ],
    "main": "./lib/index.js",
    "module": "./lib/index.mjs",
    "types": "./index.d.ts",
    "browser": "./lib/index.js",
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "require": "./lib/index.js",
            "import": "./lib/index.mjs"
        }
    },
    "files": [
        "/lib",
        "/index.d.ts"
    ],
    "scripts": {
        "sandbox": "jest ./tests/sandbox.test.tsx",
        "build": "rimraf ./lib && rollup -c",
        "build:dev": "rimraf ./lib && rollup -cw"
    },
    "peerDependencies": {
        "@types/react": ">=18.0.0",
        "react": ">=18.0.0"
    },
    "peerDependenciesMeta": {
        "@types/react": {
            "optional": true
        },
        "react": {
            "optional": true
        }
    },
    "dependencies": {
        "@fluxmodels/core": "~1.0.1"
    },
    "devDependencies": {
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-terser": "^0.4.4",
        "@rollup/plugin-typescript": "^12.3.0",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.0",
        "@types/jest": "^29.5.12",
        "@types/node": "^20.14.10",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "globals": "^16.5.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "rimraf": "^6.1.2",
        "rollup": "^4.53.3",
        "rollup-plugin-filesize": "^10.0.0",
        "ts-jest": "^29.4.6",
        "typescript": "^5.5.3"
    },
    "packageManager": "yarn@4.11.0",
    "sideEffects": false
}
